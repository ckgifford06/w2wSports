{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
{
  "crons": [
    {
      "path": "/api/send-digest?token=YOUR_CRON_SECRET",
      "schedule": "0 13 * * *"
    }
  ]
}
