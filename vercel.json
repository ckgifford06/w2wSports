{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/api/send-digest",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/save-scores",
      "schedule": "0 5 * * *"
    }
  ]
}
